# Copy to .env and adjust. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

DATABASE_URL=postgres://jihudumie:jihudumie_dev@localhost:5432/jihudumie

# --- OTP policy (spec 43: configuration, never constants in the client) ------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_SMS_PER_DAY=15

# Pepper for hashing OTPs. Rotating it invalidates every outstanding code.
OTP_PEPPER=change-me-too

# --- Sessions ----------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# Whether verifying a new phone number signs the customer out everywhere else.
PHONE_CHANGE_REVOKES_OTHER_SESSIONS=True

# --- Account policy ----------------------------------------------------------
ENFORCE_EMAIL_UNIQUENESS=False

# --- SMS ---------------------------------------------------------------------
# 'logging' prints the code to the console and sends nothing. Swap to the real
# provider once its credentials are known.
SMS_PROVIDER=logging

# Webline Africa issues one Sanctum-style token ("500|abc...") and no secret.
# It is sent as a field in the JSON body, not as a header.
SMS_API_TOKEN=
SMS_SENDER_ID=TAARIFA
SMS_BASE_URL=https://sms.webline.africa/api/http

# --- Orders pricing (orders/pricing.py) ---------------------------------------
# price = max(ORDER_MIN_PRICE_TSH, distance_km * the vehicle's rate below).
# The per-km rates are placeholders -- no real figure from the client yet;
# they only preserve the old flat table's ratio. Update the moment you have
# real numbers; nothing else needs to change.
ORDER_MIN_PRICE_TSH=2000
ORDER_RATE_PER_KM_MOTORCYCLE_TSH=500
ORDER_RATE_PER_KM_BAJAJI_TSH=650
ORDER_RATE_PER_KM_CAR_TSH=800
ORDER_RATE_PER_KM_VAN_TSH=1200
